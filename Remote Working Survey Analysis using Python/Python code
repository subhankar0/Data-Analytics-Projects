    ax = card_ax([x0, 0.885, 0.18, 0.06])
    ax.text(0.5, 0.70, val, ha="center", va="center", fontsize=13, fontweight="bold", color=col, transform=ax.transAxes)
    ax.text(0.5, 0.20, lbl, ha="center", va="center", fontsize=7.5, color=MUTED, transform=ax.transAxes, wrap=True)
    ax.set_xticks([]); ax.set_yticks([])
 
