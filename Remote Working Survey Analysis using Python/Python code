# --- 2021 Wellbeing ----------------------------------------------------------
agree_vals = ["Somewhat agree", "Strongly agree"]
def pct_agree(series):
    vc = series.value_counts()
    total = vc.sum()
    return sum(vc.get(v, 0) for v in agree_vals) / total * 100
 
